# FluentRead-Go 环境变量（附录 A）
# 复制为 .env 后填写。密钥类只从环境变量读取，不入库、不写日志、不下发前端（FR-1002）。

# ---------- 服务 ----------
FR_LISTEN=:8787
FR_DB_PATH=data/fluentread.db

# ---------- L1 默认线路（OpenAI 兼容，推荐 LiteLLM，DR-9）----------
# 容器内互访用 http://litellm:4000；本机直跑用 http://127.0.0.1:4000
FR_BASE_URL=http://127.0.0.1:4000
# LiteLLM 虚拟密钥（与 docker-compose 里的 LITELLM_MASTER_KEY 一致）
# 支持逗号分隔多把（FR-1102：失败自动切下一把并冷却）
FR_API_KEY=sk-please-change
# 站点默认模型；留空则取 deploy/models.json 里 role=primary 且 enabled 的第一项（FR-401/402）
FR_MODEL=deepseek-chat

# ---------- 免费降级后备（DR-10，Go 直连、不经 LiteLLM）----------
# mymemory 或空=禁用；地址留空时用官方端点，测试才需要改
FR_FALLBACK_TYPE=mymemory
FR_FALLBACK_BASE_URL=

# ---------- 模型清单（FR-402/408/409）----------
# 展示与路由清单；实际可调用性以网关 /v1/models 对账为准（巡检 FR-1103）
FR_MODELS_FILE=deploy/models.json

# ---------- 超时 / 配额 / 限流 ----------
FR_UPSTREAM_TIMEOUT_SECONDS=30
FR_VISITOR_DAILY_SEGMENTS=200
FR_SITE_DAILY_PAID_CHARS=200000
FR_RATE_PER_MINUTE=20
# 词典模型兜底的每分钟限频（§八 8.5）
FR_DICT_RATE_PER_MINUTE=10

# ---------- 翻译缓存（FR-1101）----------
FR_CACHE_ENABLED=true

# ---------- 嵌入 SDK（FR-906）----------
# 逗号分隔，例如 https://blog.example.com,https://www.example.com
# 空 = SDK 关闭（安全默认）
FR_SDK_ORIGINS=

# ---------- 提示词模板覆盖（可选，§7.7）----------
# FR_TRANSLATE_PROMPT=
# FR_PROOFREAD_PROMPT=

# ---------- 测试钩子（生产不要设置）----------
# 复习间隔分钟序列（默认 10,1440,4320,10080,20160,43200）
# FR_REVIEW_STAGES=
# 模型巡检间隔秒（默认 3600）
# FR_INSPECT_INTERVAL_SECONDS=

# ==========================================================
# 以下仅 docker-compose 的 litellm profile 使用，Go 服务不读取
# ==========================================================

# LiteLLM 主密钥，客户端拿它访问网关
LITELLM_MASTER_KEY=sk-please-change
# 预算与用量需要数据库；本地可用 SQLite 文件
DATABASE_URL=sqlite:///data/litellm.db

# 按需填，没填的模型会在调用时报错；可在 litellm.config.yaml 里注释掉
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
