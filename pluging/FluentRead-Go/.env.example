# FluentRead-Go 环境变量
# 复制为 .env 后填写。密钥类只从环境变量读取，不入库、不写日志。

# ---------- 服务 ----------
FR_ADDR=:8080
FR_DB_PATH=./data/fluentread.db
FR_REQUEST_TIMEOUT=20s
FR_AI_TIMEOUT=60s

# ---------- 模型网关（LiteLLM）----------
# 容器内互访用 http://litellm:4000；本机直跑用 http://127.0.0.1:4000
FR_GATEWAY_BASE=http://127.0.0.1:4000
# 与 docker-compose 里的 LITELLM_MASTER_KEY 保持一致
FR_GATEWAY_KEY=sk-please-change
# 站点默认模型，必须是 litellm.config.yaml 里存在的 model_name
FR_DEFAULT_MODEL=deepseek-chat

# ---------- 配额与限流 ----------
# 每个访客每天最多翻译多少"段"（空白段不计）。0 = 不限。
FR_QUOTA_DAILY=200
# 每个访客每分钟最多多少次请求。0 = 不限。
FR_RATE_LIMIT=30
# 站点级付费上游每日字符上限。触顶后自动降级到免费线路，不拒绝服务。0 = 不限。
FR_UPSTREAM_DAILY_CAP=200000
# 免费线路地址，默认官方端点。只有测试才需要改成本地假网关。
FR_MYMEMORY_BASE=

# ---------- 管理 ----------
# 留空则管理接口关闭
FR_ADMIN_PASSWORD=

# ---------- 嵌入 SDK ----------
# 逗号分隔，例如 https://blog.example.com,https://www.example.com
FR_ALLOW_ORIGINS=

# ==========================================================
# 以下仅 docker-compose 使用，Go 服务不读取
# ==========================================================

# LiteLLM 主密钥，客户端拿它访问网关
LITELLM_MASTER_KEY=sk-please-change
# 预算与用量需要数据库；本地可用 SQLite 文件
DATABASE_URL=sqlite:///data/litellm.db

# 按需填，没填的模型会在网关启动时报错，可在 litellm.config.yaml 里注释掉
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
